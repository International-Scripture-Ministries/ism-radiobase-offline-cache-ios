            "number": "1"
        },
        "chapterId": "OBA.1",
        "content": "Гордость сердца твоего обольстила тебя.\n    Ты живешь в расщелинах скал,\n    высоко строишь свой дом\n  и говоришь в сердце своем:\n    „Кто низвергнет меня на землю?“",
        "reference": "Авдий 1:3",
        "verseNumber": "3",
        "chapterNumber": 1,
        "teaching": {
            "art_url": "https://cdn-cmp-audio.thruthebible.io/art/OBA.png",
            "book_order": 31,
            "cmp_book_id": "OBA",
