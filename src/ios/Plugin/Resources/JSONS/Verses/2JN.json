        "chapterId": "2JN.1",
        "content": "Naye nnyabo kaakano nkusaba nga siri ng’akuwa ekiragiro ekiggya, naye nkujjukiza ekiragiro ekyo Katonda kye yatuwa okuva ku lubereberye nti, “Twagalanenga.”",
        "reference": "2 Yokaana 1:5",
        "verseNumber": "5",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/2JN/2JN.1.mp3"
    },
