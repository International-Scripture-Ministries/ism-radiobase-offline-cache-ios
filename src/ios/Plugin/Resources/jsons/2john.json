            "book_id": "2 John",
            "book_order": "",
            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "2",
            "verse_text": "за правду, що в нас пробуває й повік буде з нами:",
            "paragraph_number": "2",
            "teaching_id": "18836",
            "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/24f50965-e0db-469a-98ac-8c807fd271e9",
