{
  "dam_id": "UKRO30O",
  "book_id": "Song",
  "book_name": "Песен на песните",
  "book_order": "22",
  "number_of_chapters": "8",
  "chapters": "1,2,3,4,5,6,7,8",
  "lang_code": "uk",
  "chapters_list": [
    {
      "chapter_id": 1,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "1",
          "verse_text": "Соломонова Пісня над піснями.",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "2",
          "verse_text": "Нехай він цілує мене поцілунками уст своїх, бо ліпші кохання твої від вина!",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "3",
          "verse_text": "На запах оливи твої запашні, твоє ймення неначе олива розлита, тому діви кохають тебе!",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "4",
          "verse_text": "Потягни ти мене за собою, біжім! Цар впровадив мене у палати свої, ми радіти та тішитись будемо тобою, згадаємо кохання твої, від вина приємніші, поправді кохають тебе!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "5",
          "verse_text": "Дочки єрусалимські, я чорна та гарна, немов ті намети кедарські, мов занавіси Соломонові!",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "6",
          "verse_text": "Не дивіться на те, що смуглявенька я, бож сонце мене опалило, сини неньки моєї на мене розгнівалися, настановили мене сторожити виноградники, та свого виноградника власного не встерегла я!...",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "7",
          "verse_text": "Скажи ж мені ти, кого покохала душа моя: Де ти пасеш? Де даєш ти спочити у спеку отарі? Пощо біля стад твоїх друзів я буду, немов та причинна?",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "8",
          "verse_text": "Якщо ти не знаєш цього, вродливіша посеред жінок, то вийди собі за слідами отари, і випасуй при шатрах пастуших козлятка свої.",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "9",
          "verse_text": "Я тебе прирівняв до лошиці в возах фараонових, о моя ти подруженько!",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "10",
          "verse_text": "Гарні щічки твої поміж шнурами перел, а шийка твоя між разками намиста!",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "11",
          "verse_text": "Ланцюжки золоті ми поробимо тобі разом із срібними кульками!",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "12",
          "verse_text": "Доки цар при своєму столі, то мій нард видає свої пахощі.",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "13",
          "verse_text": "Мій коханий для мене мов китиця мирри: спочиває між персами в мене!",
          "paragraph_number": "13"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "14",
          "verse_text": "Мій коханий для мене мов кипрове гроно в ен-ґедських садах-виноградах!",
          "paragraph_number": "14"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "15",
          "verse_text": "Яка ти прекрасна, моя ти подруженько, яка ти хороша! Твої очі немов голубині!",
          "paragraph_number": "15"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "16",
          "verse_text": "Який ти прекрасний, о мій ти коханий, який ти приємний! а ложе нам зелень!",
          "paragraph_number": "16"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "17",
          "verse_text": "Бруси наших домів то кедрини, стелі в нас кипариси!",
          "paragraph_number": "17"
        }
      ]
    },
    {
      "chapter_id": 2,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "1",
          "verse_text": "Я саронська троянда, я долинна лілея!",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "2",
          "verse_text": "Як лілея між тереном, так подруга моя поміж дівами!",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "3",
          "verse_text": "Як та яблуня між лісовими деревами, так мій коханий поміж юнаками, його тіні жадала й сиділа я в ній, і його плід для мого піднебіння солодкий!",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "4",
          "verse_text": "Він впровадив мене до винярні, а прапор його надо мною кохання!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "5",
          "verse_text": "Підкріпіте мене виноградовим печивом, освіжіть мене яблуками, бо я хвора з кохання!",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "6",
          "verse_text": "Ліва рука його під головою моєю, правиця ж його пригортає мене!...",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "7",
          "verse_text": "Заклинаю я вас, дочки єрусалимські, газелями чи польовими оленями, щоб ви не сполохали, й щоб не збудили кохання, аж доки йому до вподоби!...",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "8",
          "verse_text": "Голос мого коханого!... Ось він іде, ось він скаче горами, по пагірках вистрибує...",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "9",
          "verse_text": "Мій коханий подібний до сарни чи до молодого оленя. Он стоїть він у нас за стіною, зазирає у вікна, заглядає у ґрати...",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "10",
          "verse_text": "Мій коханий озвався й промовив до мене: Уставай же, подруго моя, моя красна, й до мене ходи!",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "11",
          "verse_text": "Бо оце проминула пора дощова, дощ ущух, перейшов собі він.",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "12",
          "verse_text": "Показались квітки на землі, пора соловейка настала, і голос горлиці в нашому краї лунає!",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "13",
          "verse_text": "Фіґа випустила свої ранні плоди, і розцвілі виноградини пахощі видали. Уставай же, подруго моя, моя красна, й до мене ходи!",
          "paragraph_number": "13"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "14",
          "verse_text": "Голубко моя у розщілинах скельних, у бескіднім сховку, дай побачити мені твоє личко, дай почути мені голосок твій, бо голос твій милий, а личко твоє уродливе!",
          "paragraph_number": "14"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "15",
          "verse_text": "Ловіть нам лисиці, лисинята маленькі, що ушкоджують нам виноградники, виноградники ж наші у цвіті!",
          "paragraph_number": "15"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "16",
          "verse_text": "Мій коханий він мій, я ж його, він пасе між лілеями!",
          "paragraph_number": "16"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "2",
          "chapter_title": "Chapter 2",
          "verse_id": "17",
          "verse_text": "Поки день прохолоду навіє, а тіні втечуть, вернись, мій коханий, стань подібний до сарни чи до молодого оленя в пахучих горах!",
          "paragraph_number": "17"
        }
      ]
    },
    {
      "chapter_id": 3,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "1",
          "verse_text": "По ночах на ложі своїм я шукала того, кого покохала душа моя... Шукала його, та його не знайшла...",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "2",
          "verse_text": "Хай устану й нехай я пройдуся по місті, хай на вулицях та на майданах того пошукаю, кого покохала душа моя! Шукала його, та його не знайшла...",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "3",
          "verse_text": "Спіткали мене сторожі, що по місті проходять... Чи не бачили часом того, кого покохала душа моя?",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "4",
          "verse_text": "Небагато пройшла я від них, та й знайшла я того, кого покохала душа моя: схопила його, й не пустила його, аж поки його не ввела у дім неньки своєї, та в кімнату тієї, що в утробі носила мене!...",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "5",
          "verse_text": "Заклинаю я вас, дочки єрусалимські, газелями чи польовими оленями, щоб ви не сполохали, щоб не збудили кохання, аж доки йому до вподоби!...",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "6",
          "verse_text": "Хто вона, що виходить із пустині, немов стовпи диму, окурена миррою й ладаном, всілякими пахощами продавця?",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "7",
          "verse_text": "Ось ложе його, Соломонове, шістдесят лицарів навколо нього, із лицарів славних Ізраїлевих!",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "8",
          "verse_text": "Усі вони мають меча, усі вправні в бою, кожен має свого меча при своєму стегні проти страху нічного.",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "9",
          "verse_text": "Ноші зробив собі цар Соломон із ливанських дерев:",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "10",
          "verse_text": "стовпці їхні зробив він із срібла, а їхне опертя золоте, пурпурове сидіння, їхня середина вистелена коханням дочок єрусалимських!...",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "3",
          "chapter_title": "Chapter 3",
          "verse_id": "11",
          "verse_text": "Підіть і побачте, о дочки сіонські, царя Соломона в вінку, що ним мати його увінчала його в день весілля його та в день радости серця його!",
          "paragraph_number": "11"
        }
      ]
    },
    {
      "chapter_id": 4,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "1",
          "verse_text": "Яка ти прекрасна, моя ти подруженько, яка ти хороша! Твої оченятка, немов ті голубки, глядять з-за серпанку твого! Твої коси немов стадо кіз, що хвилями сходять з гори Гілеадської!",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "2",
          "verse_text": "Твої зубки немов та отара овець пообстриганих, що з купелю вийшли, що котять близнята, і між ними немає неплідної...",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "3",
          "verse_text": "Твої губки немов кармазинова нитка, твої устонька красні, мов частина гранатного яблука скроня твоя за серпанком твоїм!",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "4",
          "verse_text": "Твоя шия немов та Давидова башта, на зброю збудована: тисяча щитів повішена в ній, усе щити лицарів!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "5",
          "verse_text": "Два перса твої мов ті двоє близнят молодих у газелі, що випасуються між лілеями...",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "6",
          "verse_text": "Поки день прохолоду навіє, а тіні втечуть, піду я собі на ту миррину гору й на пагірок ладану...",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "7",
          "verse_text": "Уся ти прекрасна, моя ти подруженько, і плями нема на тобі!",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "8",
          "verse_text": "Зо мною з Лівану, моя наречена, зо мною з Лівану ти підеш! Споглянеш з вершини Амани, з вершини Сеніру й Гермону, з леговища левів, з леопардових гір.",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "9",
          "verse_text": "Забрала ти серце мені, моя сестро, моя наречена, забрала ти серце мені самим очком своїм, разочком одненьким намиста свого!...",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "10",
          "verse_text": "Яке любе кохання твоє, о сестрице моя, наречена! Скільки ліпше кохання твоє за вино, а запашність олив твоїх за всі пахощі!...",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "11",
          "verse_text": "Уста твої крапають мед щільниковий, моя наречена, мед і молоко під твоїм язичком, а пахощ одежі твоєї як ліванські ті пахощі!",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "12",
          "verse_text": "Замкнений садок то сестриця моя, наречена моя замкнений садок, джерело запечатане...",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "13",
          "verse_text": "Лоно твоє сад гранатових яблук з плодом досконалим, кипри із нардами,",
          "paragraph_number": "13"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "14",
          "verse_text": "нард і шафран, пахуча тростина й кориця з усіма деревами ладану, мирра й алое зо всіма найзапашнішими пахощами,",
          "paragraph_number": "14"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "15",
          "verse_text": "ти джерело садкове, криниця живої води, та тієї, що плине з Ливану!...",
          "paragraph_number": "15"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "4",
          "chapter_title": "Chapter 4",
          "verse_id": "16",
          "verse_text": "Прокинься, о вітре з півночі, і прилинь, вітре з полудня, повій на садок мій: нехай потечуть його пахощі! Хай коханий мій прийде до саду свого, і нехай споживе плід найкращий його!...",
          "paragraph_number": "16"
        }
      ]
    },
    {
      "chapter_id": 5,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "1",
          "verse_text": "Прийшов я до саду свого, о сестро моя, наречена! Збираю я мирру свою із бальзамом своїм, споживаю свого стільника разом із медом своїм, п'ю вино я своє зо своїм молоком!... Споживайте, співдрузі, пийте до схочу, кохані!",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "2",
          "verse_text": "Я сплю, моє ж серце чуває... Ось голос мого коханого!... Стукає... Відчини мені, сестро моя, о моя ти подруженько, голубко моя, моя чиста, бо росою покрилася вся моя голова, мої кучері краплями ночі!...",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "3",
          "verse_text": "Зняла я одежу свою, як знову її надягну? Помила я ніжки свої, як же їх занечищу?...",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "4",
          "verse_text": "Мій коханий простяг свою руку крізь отвір, і нутро моє схвилювалось від нього!...",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "5",
          "verse_text": "Встала я відчинити своєму коханому, а з рук моїх капала мирра, і мирра текла на засувки замка з моїх пальців...",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "6",
          "verse_text": "Відчинила своєму коханому, а коханий мій зник, відійшов!... Душі не ставало в мені, як він говорив... Я шукала його, та його не знайшла... Я гукала його, та він не відізвався до мене...",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "7",
          "verse_text": "Стріли мене сторожі, що ходять по місті, набили мене, завдали мені рани... Здерли з мене моє покривало, сторожі міських мурів!",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "8",
          "verse_text": "Заклинаю я вас, дочки єрусалимські, як мого коханого стрінете ви, що йому повісте? Що я хвора з кохання!",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "9",
          "verse_text": "Чим коханий твій кращий від інших коханих, вродливіша з жінок? Чим коханий твій кращий від інших коханих, що так заклинаєш ти нас?",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "10",
          "verse_text": "Коханий мій білий й рум'яний, визначніший він від десяти тисяч інших...",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "11",
          "verse_text": "Голова його щиреє золото, його кучері пальмове віття, чорні, як ворон...",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "12",
          "verse_text": "Його очі немов голубки над джерелами водними, у молоці повимивані, що над повним струмком посідали!",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "13",
          "verse_text": "Його личка як грядка бальзаму, немов квітники запашні! Його губи лілеї, з яких капає мирра текуча!",
          "paragraph_number": "13"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "14",
          "verse_text": "Його руки стовпці золоті, повисаджувані хризолітом, а лоно його твір мистецький з слонової кости, покритий сапфірами!",
          "paragraph_number": "14"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "15",
          "verse_text": "Його стегна стовпи мармурові, поставлені на золотії підстави! Його вигляд немов той Ливан, він юнак як ті кедри!",
          "paragraph_number": "15"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "5",
          "chapter_title": "Chapter 5",
          "verse_id": "16",
          "verse_text": "Уста його солодощі, і він увесь пожадання... Оце мій коханий, й оце мій дружок, дочки єрусалимські!",
          "paragraph_number": "16"
        }
      ]
    },
    {
      "chapter_id": 6,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "1",
          "verse_text": "Куди твій коханий пішов, о найвродливіша з жінок? Куди спрямував твій коханий? Бо ми пошукаємо його із тобою.",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "2",
          "verse_text": "Мій коханий пішов до садочка свого, в квітники запашні, щоб пасти в садках і збирати лілеї.",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "3",
          "verse_text": "Я належу своєму коханому, а мені мій коханий, що пасе між лілеями!",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "4",
          "verse_text": "Ти прекрасна, моя ти подруженько, мов та Тірца, ти хороша, як Єрусалим, ти грізна, як війська з прапорами!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "5",
          "verse_text": "Відверни ти свої оченята від мене, бо вони непокоять мене! Твої коси немов стадо кіз, що хвилями сходять з того Гілеаду!",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "6",
          "verse_text": "Твої зуби немов та отара овець, що з купелю вийшли, що котять близнята, і між ними немає неплідної!",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "7",
          "verse_text": "Мов частина гранатного яблука скроня твоя за серпанком твоїм!",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "8",
          "verse_text": "Шістдесят є цариць, і вісімдесят є наложниць, а дівчатам немає числа,",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "9",
          "verse_text": "та єдина вона ця голубка моя, моя чиста! У неньки своєї вона одиначка, обрана вона у своєї родительки! Як бачили дочки Сіону її, то щасливою звали її, цариці й наложниці то вихваляли її:",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "10",
          "verse_text": "Хто це така, що вона виглядає, немов та досвітня зоря, прекрасна, як місяць, як сонце ясна, як полки з прапорами грізна?",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "11",
          "verse_text": "Зійшла я в оріховий сад, щоб поглянути на пуп'яночки при потоці, щоб побачити там, чи зацвів виноград, чи гранатові яблуні порозцвітали?",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "12",
          "verse_text": "І не зчулася я, як мене посадила душа моя між колесниці моєї дружини бояр...",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "6",
          "chapter_title": "Chapter 6",
          "verse_id": "13",
          "verse_text": "(7-1) Вернися, вернись, Суламітко! Вернися, вернися, нехай ми на тебе надивимось! Чого вам дивитися на Суламітку, немов би на танець військовий?",
          "paragraph_number": "13"
        }
      ]
    },
    {
      "chapter_id": 7,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "1",
          "verse_text": "(7-2) Хороші які стали ноги твої в черевичках, князівно моя! Заокруглення стегон твоїх мов намисто, руками мистецькими виточене!",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "2",
          "verse_text": "(7-3) Твоє лоно немов круглоточена чаша, в якій не забракне вина запашного! Твій живіт сніп пшениці, оточений тими лілеями!",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "3",
          "verse_text": "(7-4) Два перса твої немов двоє сарняток близнят!",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "4",
          "verse_text": "(7-5) Твоя шия як башта із кости слонової, твої очі озерця в Хешбоні при брамі того Бат-Рабіму, в тебе ніс немов башта ливанська, що дивиться все в бік Дамаску!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "5",
          "verse_text": "(7-6) Голівка твоя на тобі мов Кармел, а коса на голівці твоїй немов пурпур, полонений цар тими кучерями!",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "6",
          "verse_text": "(7-7) Яка ти прекрасна й приємна яка, о кохання в розкошах!",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "7",
          "verse_text": "(7-8) Став подібний до пальми твій стан, твої ж перса до грон виноградних!",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "8",
          "verse_text": "(7-9) Я подумав: виберуся на цю пальму, схоплюся за віття її, і нехай стануть перса твої, немов виноградні ті грона, а пахощ дихання твого як яблука!...",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "9",
          "verse_text": "(7-10) А уста твої як найліпше вино: простує воно до мого коханого, чинить промовистими й уста сплячих!",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "10",
          "verse_text": "(7-11) Я належу своєму коханому, а його пожадання до мене!",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "11",
          "verse_text": "(7-12) Ходи ж, мій коханий, та вийдемо в поле, переночуємо в селах!",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "12",
          "verse_text": "(7-13) Устанемо рано, й ходім у сади-виногради, подивимося, чи зацвів виноград, чи квітки розцвілись, чи гранатові яблуні порозцвітали?... Там кохання своє тобі дам!",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "7",
          "chapter_title": "Chapter 7",
          "verse_id": "13",
          "verse_text": "(7-14) Видадуть пах мандрагори, при наших же входах всілякі коштовні плоди, нові та старі, що я їх заховала для тебе, коханий ти мій!",
          "paragraph_number": "13"
        }
      ]
    },
    {
      "chapter_id": 8,
      "copyright_info": "Public Domain",
      "chapter_audio": "",
      "verses": [
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "1",
          "verse_text": "О, коли б ти мені був за брата, що перса ссав в нені моєї, коли б стріла тебе я на вулиці, цілувала б тебе, і ніхто мені не докоряв би!",
          "paragraph_number": "1"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "2",
          "verse_text": "Повела б я тебе й привела б у дім нені своєї: ти навчав би мене, я б тебе напоїла вином запашним, соком гранатових яблук своїх!",
          "paragraph_number": "2"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "3",
          "verse_text": "Ліва рука його під головою моєю, правиця ж його пригортає мене!...",
          "paragraph_number": "3"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "4",
          "verse_text": "Заклинаю я вас, дочки єрусалимські, нащо б сполохали, й нащо б збудили кохання, аж доки йому до вподоби!",
          "paragraph_number": "4"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "5",
          "verse_text": "Хто вона, що виходить із пустині, спираючися на свого коханого? Під яблунею я збудила тебе, там повила тебе мати твоя, там тебе повила твоя породителька!",
          "paragraph_number": "5"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "6",
          "verse_text": "Поклади ти мене, як печатку на серце своє, як печать на рамено своє, бо сильне кохання, як смерть, заздрощі непереможні, немов той шеол, його жар жар огню, воно полум'я Господа!",
          "paragraph_number": "6"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "7",
          "verse_text": "Води великі не зможуть згасити кохання, ані ріки його не заллють! Коли б хто давав за кохання маєток увесь свого дому, то ним погордили б зовсім!...",
          "paragraph_number": "7"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "8",
          "verse_text": "Є сестра в нас мала, й перс у неї нема ще. Що зробимо нашій сестричці в той день, коли сватати будуть її?",
          "paragraph_number": "8"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "9",
          "verse_text": "Якщо вона мур, забороло із срібла збудуємо на ній, а якщо вона двері обкладемо кедровою дошкою їх...",
          "paragraph_number": "9"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "10",
          "verse_text": "Я мур, мої ж перса як башти, тоді я була в його очах мов та, яка спокій провадить...",
          "paragraph_number": "10"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "11",
          "verse_text": "Виноградника мав Соломон у Баал-Гамоні, виноградника він віддавав сторожам, щоб кожен приносив за плід його тисячу срібла.",
          "paragraph_number": "11"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "12",
          "verse_text": "Але мій виноградник, що маю його, при мені! Тобі, Соломоне, хай буде та тисяча, а сторожам його плоду дві сотні!",
          "paragraph_number": "12"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "13",
          "verse_text": "О ти, що сидиш у садках, друзі твої прислухаються до твого голосу: дай почути його і мені!",
          "paragraph_number": "13"
        },
        {
          "book_name": "Song of Songs",
          "book_id": "Song of Songs",
          "book_order": "",
          "chapter_id": "8",
          "chapter_title": "Chapter 8",
          "verse_id": "14",
          "verse_text": "Утікай, мій коханий, і станься подібний до сарни собі, чи до молодого оленя у бальзамових горах!",
          "paragraph_number": "14"
        }
      ]
    }
  ]
}