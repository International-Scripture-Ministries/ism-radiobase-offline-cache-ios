            "book_order": "",
            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "2",
            "verse_text": "милість вам, і мир, і любов хай примножиться!",
            "paragraph_number": "2",
            "teaching_id": "18865",
            "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/afd75248-53f7-4cce-ae35-60e79ec25705",
