      "verses": [
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "1",
          "verse_text": "Видіння Овдія. Так сказав Господь Бог на Едом: Почули ми вістку від Господа, і посланий був між народів посол, щоб сказати: Уставайте, і станьмо на нього до бою!",
          "paragraph_number": "1",
          "teaching_id": "18779",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/1e8816dd-e450-470b-a318-257a478ccd3d",
          "teaching_name": "Авдія 1:1-5",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "teaching_start_point": "0101",
          "teaching_end_point": "0105"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "2",
          "verse_text": "Оце Я малим тебе дав між народи, ти дуже погорджений.",
          "paragraph_number": "2",
          "teaching_id": "18779",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/1e8816dd-e450-470b-a318-257a478ccd3d",
          "teaching_name": "Авдія 1:1-5",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "teaching_start_point": "0101",
          "teaching_end_point": "0105"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "3",
          "verse_text": "Гордість серця твого обманила тебе, який перебуваєш по щілинах скельних, у високім сидінні своїм, що говориш у серці своєму: Хто скине на землю мене?",
          "paragraph_number": "3",
          "teaching_id": "18779",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/1e8816dd-e450-470b-a318-257a478ccd3d",
          "teaching_name": "Авдія 1:1-5",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "teaching_start_point": "0101",
          "teaching_end_point": "0105"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "4",
          "verse_text": "Якщо б ти піднісся, немов той орел, і якщо б ти кубло своє склав поміж зорями, то й звідти Я скину тебе, промовляє Господь!",
          "paragraph_number": "4",
          "teaching_id": "18779",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/1e8816dd-e450-470b-a318-257a478ccd3d",
          "teaching_name": "Авдія 1:1-5",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "teaching_start_point": "0101",
          "teaching_end_point": "0105"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "5",
          "verse_text": "Чи ж до тебе злодії приходили, чи нічні ті грабіжники, такий ти понищений! чи ж вони не накрали б собі скільки треба? Якщо б до тебе прийшли збирачі винограду, чи ж вони не лишили б хоч вибірків?",
          "paragraph_number": "5",
          "teaching_id": "18779",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/1e8816dd-e450-470b-a318-257a478ccd3d",
          "teaching_name": "Авдія 1:1-5",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309060_UKR_TTB_1062_06072017_Obadiah_1_1_Obadiah_1_5_MM_.mp3",
          "teaching_start_point": "0101",
          "teaching_end_point": "0105"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "6",
          "verse_text": "Як Ісав перешуканий, як криївки його переглянені!",
          "paragraph_number": "6",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "7",
          "verse_text": "Аж до границі прогнали тебе, обманять тебе твої всі союзники, переможуть тебе твої приятелі! Ті, що хліб твій їдять, пастку розставлять на тебе, нема в тому розуму!",
          "paragraph_number": "7",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "8",
          "verse_text": "Чи ж не станеться це того дня, промовляє Господь, і вигублю Я мудреців із Едому, а розум з гори Ісавової?",
          "paragraph_number": "8",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "9",
          "verse_text": "І настрашене буде лицарство твоє, о Темане, щоб був витятий кожен з Ісава убивством.",
          "paragraph_number": "9",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "10",
          "verse_text": "Через насилля на Якова на брата твого сором покриє тебе, і ти витятий будеш навіки.",
          "paragraph_number": "10",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "11",
          "verse_text": "Того дня, коли став ти навпроти, того дня, як чужі полонили були його військо, і коли чужинці в його брами ввійшли і жереба кидали про Єрусалим, то й ти був, як один з них!",
          "paragraph_number": "11",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "12",
          "verse_text": "І тому не дивися на день свого брата, на день лиха його, і не тішся з Юдиних синів у день їхньої згуби, і не розкривай своїх уст у день утиску.",
          "paragraph_number": "12",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "13",
          "verse_text": "І не входь ти до брами народу Мого у день лиха його, і не приглядайся до зла його й ти в день нещастя його, і не простягайте своєї руки до багатства його в день нещастя його!",
          "paragraph_number": "13",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "14",
          "verse_text": "І на роздоріжжі не стій, щоб витинати його втікачів, і в день утиску не видавай його решток!",
          "paragraph_number": "14",
          "teaching_id": "18780",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/bea04de4-3b5b-4544-b289-e916b4a6c468",
          "teaching_name": "Авдія 1:6-14",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309061_UKR_TTB_1063_07072017_Obadiah_1_6_Obadiah_1_14_MM_.mp3",
          "teaching_start_point": "0106",
          "teaching_end_point": "0114"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "15",
          "verse_text": "Бо близький день Господній над усіма народами, як зробив ти, то так і тобі буде зроблено: вернеться на твою голову чин твій!",
          "paragraph_number": "15",
          "teaching_id": "18781",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/47a60e70-63b4-48b5-b0e1-5df7ff363ac7",
          "teaching_name": "Авдія 1:15-21",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
          "bible_book_eng": "Obadiah",
          "teaching_file_name": "309063_UKR_TTB_1064_10072017_Obadiah_1_15_Obadiah_1_21_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/309063_UKR_TTB_1064_10072017_Obadiah_1_15_Obadiah_1_21_MM_.mp3",
          "teaching_start_point": "0115",
          "teaching_end_point": "0121"
        },
        {
          "book_name": "Obadiah",
          "book_id": "Obadiah",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "16",
          "verse_text": "Бо як ви пили на святій Моїй горі, так народи усі завжди питимуть! І будуть пити вони, і будуть хлептати, і стануть вони, немов їх не було.",
          "paragraph_number": "16",
          "teaching_id": "18781",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/47a60e70-63b4-48b5-b0e1-5df7ff363ac7",
          "teaching_name": "Авдія 1:15-21",
          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Obadiah.jpg",
          "bible_book": "Авдія",
