          "book_id": "Haggai",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "5",
          "verse_text": "А тепер отак промовляє Господь Саваот: Зверніть ваше серце до ваших доріг!",
          "paragraph_number": "5",
          "teaching_id": "18875",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/979a85ec-0f0f-4238-8ebf-62b38cfda20a",
