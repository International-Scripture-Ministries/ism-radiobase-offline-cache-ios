          "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/Haggai.jpg",
          "bible_book": "Аггея",
          "bible_book_eng": "Haggai",
          "teaching_file_name": "310089_UKR_TTB_1158_17112017_Haggai_1_5_Haggai_1_7_MM_.mp3",
          "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/310089_UKR_TTB_1158_17112017_Haggai_1_5_Haggai_1_7_MM_.mp3",
          "teaching_start_point": "0105",
          "teaching_end_point": "0107"
        },
        {
          "book_name": "Haggai",
          "book_id": "Haggai",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "6",
          "verse_text": "Багато ви сієте, та збираєте мало, їсте, та не насичуєтеся, п'єте та не напиваєтеся, зодягаєтеся та не тепло вам, а той, хто заробляє, заробляє для дірявого гаманця.",
          "paragraph_number": "6",
          "teaching_id": "18875",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/979a85ec-0f0f-4238-8ebf-62b38cfda20a",
          "teaching_name": "Аггея 1:5-7",
