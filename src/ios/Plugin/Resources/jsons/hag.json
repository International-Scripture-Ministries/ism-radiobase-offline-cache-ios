          "book_id": "Haggai",
          "book_order": "",
          "chapter_id": "1",
          "chapter_title": "Chapter 1",
          "verse_id": "4",
          "verse_text": "Чи час вам сидіти по ваших домах, покритих кафлями, хоч дім цей збурений?",
          "paragraph_number": "4",
          "teaching_id": "18874",
          "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/9819e882-b147-407f-a08d-14a9662cb5c6",
