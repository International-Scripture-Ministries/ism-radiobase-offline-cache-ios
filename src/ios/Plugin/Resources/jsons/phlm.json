            "book_id": "Philemon",
            "book_order": "",
            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "8",
            "verse_text": "Через це, хоч я маю велику відвагу в Христі подавати накази тобі про потрібне,",
            "paragraph_number": "8",
            "teaching_id": "18618",
            "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/07fec282-8f9b-45b4-b084-fdee94c39427",
