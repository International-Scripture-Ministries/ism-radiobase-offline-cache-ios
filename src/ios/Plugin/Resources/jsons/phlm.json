            "folder_path": "https://ttb-content-migrations-gigster.s3.us-west-2.amazonaws.com/TAM_TTB-Tamil+BI/288245_UKR_TTB_0901_23112016_Philemon_1_1_Philemon_1_25_MM_.mp3",
            "teaching_start_point": "0101",
            "teaching_end_point": "0125"
          },
          {
            "book_name": "Philemon",
            "book_id": "Philemon",
            "book_order": "",
            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "7",
            "verse_text": "Бо ми маємо радість велику й потіху в любові твоїй, серця бо святих заспокоїв ти, брате.",
            "paragraph_number": "7",
            "teaching_id": "18618",
            "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/07fec282-8f9b-45b4-b084-fdee94c39427",
            "teaching_name": "Филимон 1:1-25",
            "teachings_badge_image": "https://manage.churchbase.com/uploads/ttb_bible_badges/philemon.jpg",
            "bible_book": "Филимон",
            "bible_book_eng": "Philemon",
            "teaching_file_name": "288245_UKR_TTB_0901_23112016_Philemon_1_1_Philemon_1_25_MM_.mp3",
