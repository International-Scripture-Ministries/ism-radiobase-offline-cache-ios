            "book_order": "",
            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "5",
            "verse_text": "Бо я чув про любов твою й віру, яку маєш до Господа Ісуса, і до всіх святих,",
            "paragraph_number": "5",
            "teaching_id": "18618",
            "teaching_audio": "https://ttb-transcoder-final-prod.s3.us-west-2.amazonaws.com/07fec282-8f9b-45b4-b084-fdee94c39427",
