            "chapter_id": "1",
            "chapter_title": "Chapter 1",
            "verse_id": "4",
            "verse_text": "Я завсіди дякую Богові моєму, коли тебе згадую в молитвах своїх.",
            "paragraph_number": "4",
            "teaching_id": "18618",
