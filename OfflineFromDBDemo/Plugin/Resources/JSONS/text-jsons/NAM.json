        },
        "chapterId": "NAM.1",
        "content": "Kuno kwe kwolesebwa Katonda kwe yalaga Nakkumu, Omwerukoosi okukwata ku bibambulira ebyali bijjira Nineeve.",
        "reference": "Nakkumu 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/NAM/NAM.1.mp3"
    },
    {
        "_id": "64121a547e4909dcafd44e53",
        "bibleId": "f276be3571f516cb-01",
        "id": "NAM.1.2",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cc40",
