[
    {
        "_id": "64b58e2d531092a820bb7318",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.1",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Elkosini Nahum anisoadehunu nwoma a ɛyɛ nkɔmhyɛ a ɛfa Ninewe ho.",
        "reference": "Nahum 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7354",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.2",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Awurade yɛ ninkunfoɔ ne aweretɔ Onyankopɔn,\n    Awurade tɔ wedeɛ na abufuo ahyɛ no ma.\n  Awurade tɔ nʼatamfoɔ so wedeɛ\n    na nʼabufuo tena wɔn so.",
        "reference": "Nahum 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb73a7",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.3",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Awurade bo kyɛre fu, na ne tumi so,\n    na ɔtwe ɔfɔdifoɔ aso.\n  Ne kwan wɔ ntwahoframa ne ahum mu,\n    omununkum yɛ ne nan ase mfuturo.",
        "reference": "Nahum 1:3",
        "verseNumber": "3",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb73d7",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.4",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Ɔteatea ɛpo na ɔma ɛwe;\n    ɔma nsubɔntene nyinaa wewe.\n  Basan ne Karmel twintwam\n    na Lebanon frɔmfrɔmyɛ nso kusa.",
        "reference": "Nahum 1:4",
        "verseNumber": "4",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb745a",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.5",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Mmepɔ woso biribiri nʼanim\n    na nkokoɔ nane.\n  Asase, ewiase ne wɔn a wɔwɔ mu nyinaa\n    woso nʼanim.",
        "reference": "Nahum 1:5",
        "verseNumber": "5",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb747c",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.6",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Hwan na ɔbɛtumi agyina nʼabufuo ano?\n    Hwan na ɔbɛtumi atena nʼabufuhyeɛ mu?\n  Nʼabufuo hwie te sɛ ogya;\n    abotan yam wɔ nʼanim.",
        "reference": "Nahum 1:6",
        "verseNumber": "6",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb74bd",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.7",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Awurade yɛ,\n    ɔyɛ ahohia mu dwanekɔbea.\n  Nʼani wɔ wɔn a wɔde wɔn ho to no so no so.",
        "reference": "Nahum 1:7",
        "verseNumber": "7",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7523",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.8",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Nanso, ɔnam nsuyire nwanwasoɔ so\n  bɛma Ninewe aba awieeɛ.\n    Ɔbɛtaa nʼatamfoɔ akɔduru esum kabii mu.",
        "reference": "Nahum 1:8",
        "verseNumber": "8",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7559",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.9",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Ɛpɔ biara a wɔbɛbɔ atia Awurade no,\n    ɔbɛsɛe no;\n    ɔhaw biara remma ne mprenu so.",
        "reference": "Nahum 1:9",
        "verseNumber": "9",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb75a8",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.10",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Wɔde nkasɛɛ bɛkyekyere wɔn ho,\n    na ɛberɛ a wɔn nsa aboro wɔn no\n    wɔbɛhye wɔn sɛ wira dwaneeɛ a wɔaboa ano.",
        "reference": "Nahum 1:10",
        "verseNumber": "10",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7613",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.11",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Ao, Ninewe, wo mu na\n    deɛ ɔbɔ ɛpɔ bɔne tia Awurade\n  na ɔtu fo bɔne no firie.",
        "reference": "Nahum 1:11",
        "verseNumber": "11",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7639",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.12",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Deɛ Awurade seɛ nie:\n    “Ɛwom sɛ wɔwɔ apamfoɔ a wɔdɔɔso deɛ,\n  nanso wɔbɛsɛe wɔn ama wɔayera.\n    Ao Yuda, ɛwom sɛ mama ɔhaw aba wo so,\n    nanso merenyɛ saa bio.",
        "reference": "Nahum 1:12",
        "verseNumber": "12",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb7671",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.13",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Afei, mɛbubu kɔnnua a ɛda wo kɔn mu\n    na matete nkɔnsɔnkɔnsɔn no mu.”",
        "reference": "Nahum 1:13",
        "verseNumber": "13",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb769e",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.14",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Ninewe, Awurade aka ɔhyɛ asɛm a ɛfa wo ho:\n    “Worennya asefoɔ a wo din bɛda wɔn so.\n  Mɛsɛe nsɛsodeɛ a wɔasene ne ahoni a wɔaguo\n    a ɛsisi wʼabosonnan mu no.\n  Mɛsiesie wʼadamena\n    ɛfiri sɛ wadane ayɛ atantanneɛ.”",
        "reference": "Nahum 1:14",
        "verseNumber": "14",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2d531092a820bb76e4",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.1.15",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db25e5",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.1",
        "content": "Hwɛ mmepɔ no so,\n    deɛ a ɔde asɛmpa no ba no anammɔn\n    ɔno na ɔka asomdwoesɛm!\n  Ao, Yuda di wʼafahyɛ na\n    di wɔ bɔhyɛ so.\n  Nnipa bɔne rentu wo so sa bio;\n    Wɔbɛsɛe wɔn pasaa.",
        "reference": "Nahum 1:15",
        "verseNumber": "15",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb7818",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.1",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Ɔtohyɛsoɔni reba wo so, Ninewe\n    bɔ aban no ho ban,\n  wɛn ɛkwan no,\n    bɔ wo ho so\n  na boa wʼahoɔden nyinaa ano!",
        "reference": "Nahum 2:1",
        "verseNumber": "1",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb787f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.2",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Awurade de Yakob animuonyam bɛsane ama no\n    te sɛ Israel deɛ no,\n  ɛwom sɛ, asɛefoɔ no ama ada mpan\n    na wɔasɛe ne bobe mfuo.",
        "reference": "Nahum 2:2",
        "verseNumber": "2",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb78eb",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.3",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Asraafoɔ no akokyɛm yɛ kɔkɔɔ;\n    akofoɔ no hyehyɛ kɔben akotaadeɛ.\n  Nnadeɛ a wɔde yɛɛ nteaseɛnam no\n    twa nyinam nyinam sɛ da a wɔyɛeɛ no;\n    mpea a wapoma wɔ nnua so no rehim.",
        "reference": "Nahum 2:3",
        "verseNumber": "3",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb7920",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.4",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Nteaseɛnam no twi fa mmɔntene so,\n    na wɔdi akɔneaba.\n  Wɔte sɛ ogyatɛn a ɛrederɛ;\n    wɔbɔ yerɛdɛ te sɛ anyinam.",
        "reference": "Nahum 2:4",
        "verseNumber": "4",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb798d",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.5",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Ɔfrɛfrɛɛ nʼakofoɔ a wodi mu\n    nanso wɔsuntisunti wɔ ɛkwan mu.\n  Wɔde mmirika kɔ kuropɔn no afasuo ho;\n    na wɔyɛ wɔn akokyɛm krado.",
        "reference": "Nahum 2:5",
        "verseNumber": "5",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb79bf",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.6",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Wɔbuebue asubɔnten apono no,\n    na ahemfie no dwiri gu fam.",
        "reference": "Nahum 2:6",
        "verseNumber": "6",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb79fd",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.7",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Wɔhyɛ mmaraden sɛ\n    wɔmfa kuropɔn no nnommum\n  na wɔmfa wɔn nkɔ.\n    Ne mfenaa de wɔn nsa gu wɔn koko so\n    su te sɛ mmorɔnoma.",
        "reference": "Nahum 2:7",
        "verseNumber": "7",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb7a3c",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.8",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Ninewe te sɛ ɔtadeɛ a\n    emu nsuo resene korɔ.\n  Woteam sɛ, “Monnyina hɔ! Monnyina hɔ!”\n    Nanso, obiara ansane nʼakyi.",
        "reference": "Nahum 2:8",
        "verseNumber": "8",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2e531092a820bb7a73",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.9",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Momfom dwetɛ no!\n    Momfom sikakɔkɔɔ no!\n  Ahonyadeɛ a ɛwɔ akoradan mu nyinaa!\n    Na ahonyadeɛ no dɔɔso.",
        "reference": "Nahum 2:9",
        "verseNumber": "9",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7aae",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.10",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Wɔabɔ Ninewe korɔno, wɔayɛ no pasaa!\n    Akoma boto, na nkotodwe woso woso,\n    nnipa ho popo na wɔn anim to hoa.",
        "reference": "Nahum 2:10",
        "verseNumber": "10",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7b0b",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.11",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Seesei ɛhe na gyatabuo no wɔ,\n    baabi a wɔma wɔn mma aduane no,\n  baabi a gyatanini ne gyatabereɛ korɔ\n    na wɔn mma nso kɔ a wɔnsuro?",
        "reference": "Nahum 2:11",
        "verseNumber": "11",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7b85",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.12",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "Gyata akum deɛ ɛbɛmee ne mma.\n    Wabobɔ ahaboa ama gyatabereɛ no.\n  Ɔde deɛ wakum ahyɛ ne bɔn ma\n    na ɔde ahaboa ahyɛ nʼatuo mama.",
        "reference": "Nahum 2:12",
        "verseNumber": "12",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7bad",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.2.13",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db261c",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.2",
        "content": "“Me ne wo nnka,”\n    sɛdeɛ Asafo Awurade seɛ ni,\n  “Mɛhye wo nteaseɛnam na adane wisie\n    na akofena bɛkunkum wʼagyata mma.\n  Merennya wo ahaboa biara wɔ asase so.\n    Wɔrente wʼasomafoɔ no nne bio.”",
        "reference": "Nahum 2:13",
        "verseNumber": "13",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7cc4",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.1",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Nnome nka mogya kuropɔn\n    a atorɔ ne korɔno ahyɛ no ma\n    na amanehunufoɔ mmpa mu da!",
        "reference": "Nahum 3:1",
        "verseNumber": "1",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7d02",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.2",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Apɔnkɔkafoɔ abaa regyegye,\n    nteaseɛnam nhankra reyɛ kirididi\n  Apɔnkɔ rehurihuri\n    ne nteaseɛnam redenkye denkye.",
        "reference": "Nahum 3:2",
        "verseNumber": "2",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7d49",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.3",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Apɔnkɔ ne wɔn sotefoɔ ko kɔ wɔn anim\n    akofena twa nyinam nyinam\n    na mpea nso pa yerɛ yerɛ.\n  Atɔfoɔ bebree,\n    awufoɔ a ebi deda ebi soɔ,\n  afunu a wɔntumi nkan wɔn dodoɔ\n    a nnipa tiatia soɔ.",
        "reference": "Nahum 3:3",
        "verseNumber": "3",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7dad",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.4",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Yei nyinaa firi odwamanfoɔ bi akɔnnɔ,\n    ntafowayifoɔ no nnaadaa dodoɔ no.\n  Ɔno na ɔde nʼadwamammɔ tɔn amanaman\n    na ɔde nʼabayisɛm tɔn nnipa.",
        "reference": "Nahum 3:4",
        "verseNumber": "4",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7dd4",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.5",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "“Me ne wo nnka,” sɛdeɛ Asafo Awurade seɛ ni,\n    “Mɛpagya wʼatadeɛ akɔ soro.\n  Mɛma amanaman ahunu wʼadagya\n    na ahennie ahodoɔ nso ahunu wʼanimguaseɛ.",
        "reference": "Nahum 3:5",
        "verseNumber": "5",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7e05",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.6",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Mede efi bɛfɔre wo ho,\n    mɛbu wo animtia\n    na mama nnipa ahwɛ wo.",
        "reference": "Nahum 3:6",
        "verseNumber": "6",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e2f531092a820bb7e36",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.7",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Obiara a ɔbɛhunu wo bɛdwane afiri wo ho aka sɛ,\n    ‘Ninewe abɔ, na hwan na ɔbɛsu no?’\n    Ɛhe na menya obi akyekyere wo werɛ?”",
        "reference": "Nahum 3:7",
        "verseNumber": "7",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7e5a",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.8",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Woyɛ sene Tebes a\n    ɛda Asubɔnten Nil ho a\n    nsuo atwa he ho ahyia anaa?\n  Asubɔnten bɔ ne ho ban\n    na nsuo yɛ ne fasuo.",
        "reference": "Nahum 3:8",
        "verseNumber": "8",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7eae",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.9",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Kus ne Misraim yɛ ne dɔm a wɔntumi nkan wɔn.\n    Put ne Libia ka nʼadomfoɔ ho.",
        "reference": "Nahum 3:9",
        "verseNumber": "9",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7efd",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.10",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Nanso wɔfaa no dommum\n    twaa no asuo.\n  Wɔtoo ne mmadoma hwehwee fam\n    ma wɔtetee wɔ mmɔntene so.\n  Wɔbɔɔ nʼaberempɔn so ntonto,\n    na nʼatitire nso wɔde nkɔnsɔnkɔnsɔn guguu wɔn.",
        "reference": "Nahum 3:10",
        "verseNumber": "10",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7f2f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.11",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Wo nso wʼani so bɛyɛ wo hagyahagya sɛ ɔsabofoɔ\n    Na wo bɛhinta wo ho\n    de akɔpɛ dwanekɔbea wɔ atamfoɔ nkyɛn.",
        "reference": "Nahum 3:11",
        "verseNumber": "11",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7f83",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.12",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Wʼaban nyinaa te sɛ borɔdɔma nnua\n    a aso aba foforɔ:\n  sɛ wɔwoso a\n    aba no tete gu ma deɛ ɔrepɛ bi adi.",
        "reference": "Nahum 3:12",
        "verseNumber": "12",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7fc1",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.13",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Hwɛ wʼakofoɔ\n    wɔn nyinaa yɛ mmaa!\n  Wʼasase so apono ano deda hɔ ma wʼatamfoɔ;\n    ogya ahye wʼapono no akyiri adaban.",
        "reference": "Nahum 3:13",
        "verseNumber": "13",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb7fe8",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.14",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Sesa nsuo sie ma otua no.\n    Yere wo banbɔ mu!\n  Wɔ dɔteɛ no\n    na siesie ntayaa a wato no!",
        "reference": "Nahum 3:14",
        "verseNumber": "14",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb8029",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.15",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Ɛhɔ na ogya bɛhye woɔ;\n    akofena bɛtwa wo ahwe fam,\n  na ayɛ wo sɛdeɛ mmɛbɛ adi wo nam.\n    Mo nnɔre sɛ mmɛbɛ anaa ntutummɛ!",
        "reference": "Nahum 3:15",
        "verseNumber": "15",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb806a",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.16",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Wama wʼadwadifoɔ adɔɔso,\n    wɔn dodoɔ asene ɔsoro nsoromma,\n  nanso wɔte sɛ ntutummɛ a wɔbɔ asase no kwaterekwa\n    na afei wɔtu kɔ.",
        "reference": "Nahum 3:16",
        "verseNumber": "16",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb80a9",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.17",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Wʼawɛmfoɔ te sɛ ntutummɛ.\n    Wʼadwumayɛfoɔ te sɛ ntutummɛ akuo\n    a wɔsensam ban ho awɔ da.\n  Adekyeɛ mu owia pue a wɔtu kɔ,\n    na obi nnim faako a wɔkɔ.",
        "reference": "Nahum 3:17",
        "verseNumber": "17",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e30531092a820bb80e4",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "NAM.3.18",
        "__v": 0,
        "bookId": "NAM",
        "chapter": {
            "_id": "626b6bc47999137613db265d",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "NAM",
            "id": "NAM.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db2554"
        },
        "chapterId": "NAM.3",
        "content": "Ao, Asiriahene wo nnwanhwɛfoɔ retɔ nko.\n    Wʼanimuonyamfoɔ deda hɔ rehome.\n  Wo nkurɔfoɔ abɔ apete wɔ mmepɔ no so\n    a wɔnni anoboaboafoɔ.",
        "reference": "Nahum 3:18",
        "verseNumber": "18",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
