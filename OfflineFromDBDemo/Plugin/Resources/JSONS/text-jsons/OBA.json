[
    {
        "_id": "64b58e17531092a820bb2b4a",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "OBA.1.1",
        "__v": 0,
        "bookId": "OBA",
        "chapter": {
            "_id": "626b6bc37999137613db212b",
            "bibleId": "c97c5e017bdf893c-01",
