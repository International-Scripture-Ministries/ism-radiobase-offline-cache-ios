            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.2",
        "content": "Kale nno guma omwoyo, ggwe Zerubbaberi, bw’ayogera Mukama; guma omwoyo, ggwe Yoswa mutabani wa Yekozadaaki kabona asinga obukulu; mugume omwoyo mmwe mwenna abantu ab’omu nsi,’ bw’ayogera Mukama, ‘Mukole, kubanga ndi wamu nammwe,’ bw’ayogera Mukama ow’Eggye.",
        "reference": "Kaggayi 2:4",
        "verseNumber": "4",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
    },
    {
        "_id": "64121a687e4909dcafd49990",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAG.2.5",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "62661e22c35ce9345aa3cfd6",
