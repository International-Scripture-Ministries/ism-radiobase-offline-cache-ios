            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.2",
        "content": "“ ‘Ku lunaku olwo, ggwe omuweereza wange Zerubbaberi mutabani wa Seyalutyeri, ndikufuula ng’akabonero, kubanga nkulonze,’ bw’ayogera Mukama ow’Eggye.”",
        "reference": "Kaggayi 2:23",
        "verseNumber": "23",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
