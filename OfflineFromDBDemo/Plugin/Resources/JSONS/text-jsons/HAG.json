            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.2",
        "content": "“Bw’atyo bw’ayogera Mukama ow’Eggye nti, ‘Mu bbanga eritali ly’ewala ndikankanya eggulu n’ensi, n’ennyanja n’olukalu.",
        "reference": "Kaggayi 2:6",
        "verseNumber": "6",
        "chapterNumber": 2,
