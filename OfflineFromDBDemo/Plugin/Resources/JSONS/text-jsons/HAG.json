        },
        "chapterId": "HAG.2",
        "content": "Awo ku lunaku olw’amakumi abiri mu olumu mu mwezi ogw’omusanvu, ekigambo kya Mukama ne kijjira nnabbi Kaggayi nti,",
        "reference": "Kaggayi 2:1",
        "verseNumber": "1",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
