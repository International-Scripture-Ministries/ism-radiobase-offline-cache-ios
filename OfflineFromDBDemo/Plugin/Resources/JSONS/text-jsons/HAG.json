        },
        "chapterId": "HAG.1",
        "content": "Awo Mukama n’akubiriza omutima gwa Zerubbaberi mutabani wa Seyalutyeri, ow’essaza lya Yuda, n’omutima gwa Yoswa mutabani wa Yekozadaaki, kabona asinga obukulu, n’emitima egy’abantu bonna abaasigalawo, ne bajja ne batandika omulimu ku nnyumba ya Mukama ow’Eggye, Katonda waabwe,",
        "reference": "Kaggayi 1:14",
        "verseNumber": "14",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.1.mp3"
    },
