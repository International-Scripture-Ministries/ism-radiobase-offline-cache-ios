        },
        "chapterId": "HAG.2",
        "content": "Ndikankanya amawanga gonna, n’amawanga gonna ge njagala galijja, ne nzijuza ennyumba eno ekitiibwa,’ bw’ayogera Mukama ow’Eggye.",
        "reference": "Kaggayi 2:7",
        "verseNumber": "7",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
    },
    {
        "_id": "64121a697e4909dcafd49b55",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAG.2.8",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "62661e22c35ce9345aa3cfd6",
            "bibleId": "f276be3571f516cb-01",
