            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.2",
        "content": "‘Ani mu mmwe akyasigaddewo eyalaba ku kitiibwa ky’ennyumba eno? Ebafaananira etya kaakano? Tebafaananira ng’eteriimu kaabuntu?",
        "reference": "Kaggayi 2:3",
        "verseNumber": "3",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
    },
    {
        "_id": "64121a687e4909dcafd498e7",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAG.2.4",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "62661e22c35ce9345aa3cfd6",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAG",
            "id": "HAG.2",
