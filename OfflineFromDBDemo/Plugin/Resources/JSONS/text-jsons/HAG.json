        },
        "chapterId": "HAG.1",
        "content": "Eggulu kyerivudde liziyizibwa okuleeta omusulo, n’ettaka n’okuleeta ne litaleeta bibala byalyo.",
        "reference": "Kaggayi 1:10",
        "verseNumber": "10",
        "chapterNumber": 1,
