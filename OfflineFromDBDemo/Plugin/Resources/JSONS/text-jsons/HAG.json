            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.2",
        "content": "‘Kino kye nalagaana nammwe bwe mwali muva mu Misiri, ng’Omwoyo wange anaabeeranga nammwe. Temutya.’",
        "reference": "Kaggayi 2:5",
        "verseNumber": "5",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.2.mp3"
    },
    {
