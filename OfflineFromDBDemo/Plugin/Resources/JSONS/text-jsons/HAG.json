            "book": "62661e22c35ce9345aa3cf48"
        },
        "chapterId": "HAG.1",
        "content": "Awo Kaggayi omubaka wa Mukama n’ategeeza abantu obubaka obwava eri Mukama nti, “Ndi wamu nammwe,” bw’ayogera Mukama.",
        "reference": "Kaggayi 1:13",
        "verseNumber": "13",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAG/HAG.1.mp3"
    },
