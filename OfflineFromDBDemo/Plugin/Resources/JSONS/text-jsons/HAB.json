[
    {
        "_id": "64121a597e4909dcafd46235",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.1",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Buno bwe bubaka bwa Mukama, Kaabakuuku nnabbi bwe yafuna.",
        "reference": "Kaabakuuku 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a597e4909dcafd4626b",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.2",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Ayi Mukama, ndituusa ddi okukukaabirira\n    naye nga tompuliriza?\n  Lwaki nkukaabirira nti, “Ebikolwa eby’obukambwe bimpitiriddeko,”\n    naye n’otonnyamba?",
        "reference": "Kaabakuuku 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a597e4909dcafd4629d",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.3",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Lwaki ondaga obutali bwenkanya\n    era lwaki ogumiikiriza obukyamu?\n  Kubanga okuzikiriza n’ebikolwa eby’obukambwe biri mu maaso gange,\n    empaka n’ennyombo byeyongede.",
        "reference": "Kaabakuuku 1:3",
        "verseNumber": "3",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd462f0",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.4",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Amateeka kyegavudde gatagonderwa\n    era n’obwenkanya ne butakolebwa.\n  Ababi be basinga abatuukirivu obungi era babeebunguludde,\n    n’obwenkanya ne bulinnyirirwa.",
        "reference": "Kaabakuuku 1:4",
        "verseNumber": "4",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd4635f",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.5",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "“Mutunuulire amawanga, mwetegereze. Mwewuunyize ddala nnyo.\n  Kubanga ŋŋenda kukola omulimu mu nnaku zammwe\n    gwe mutalikkiriza\n    newaakubadde nga mugubuuliddwa.",
        "reference": "Kaabakuuku 1:5",
        "verseNumber": "5",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd46389",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.6",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Kubanga laba, nkuyimusiza Abakaludaaya,\n    eggwanga eryo eririna ettima era ekkambwe,\n  ababunye ensi eno n’eri\n    nga bawamba amawanga agatali gaabwe.",
        "reference": "Kaabakuuku 1:6",
        "verseNumber": "6",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd463cf",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.7",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Ba ntiisa, batiibwa,\n    be beetekera amateeka gaabwe era be bagassa mu nkola,\n    nga balwanirira ekitiibwa kyabwe.",
        "reference": "Kaabakuuku 1:7",
        "verseNumber": "7",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd463f7",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.8",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Embalaasi zaabwe zidduka okukira engo,\n    era mu bukambwe zikira emisege egy’ekiro.\n  Abasajja abeebagala embalaasi bava mu nsi ey’ewala\n    era bajja beesaasaanyizza\n  ne banguwa okutuuka ng’ensega bw’erumba ky’eneerya.",
        "reference": "Kaabakuuku 1:8",
        "verseNumber": "8",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd46429",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.9",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Bajja n’eryanyi bonna,\n  ebibinja byabwe birumba ng’embuyaga ey’omu ddungu;\n    ne balyoka bayoola abawambe abangi ng’omusenyu.",
        "reference": "Kaabakuuku 1:9",
        "verseNumber": "9",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd46483",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.10",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Weewaawo, basekerera bakabaka\n    ne baduulira n’abakungu.\n  Basekerera buli kibuga ekiriko ekigo\n    ne bakituumako ebifunfugu ne balinnyira okwo, ne bakiwamba.",
        "reference": "Kaabakuuku 1:10",
        "verseNumber": "10",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd464dd",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.11",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Awo ne bayita nga bakunta ng’embuyaga;\n    abantu bano omusango be gwasinga, eryanyi lyabwe ye katonda waabwe.”",
        "reference": "Kaabakuuku 1:11",
        "verseNumber": "11",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd4655c",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.12",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Ayi Mukama toli wa mirembe na mirembe,\n    ggwe Mukama Katonda wange, si ggwe Mutukuvu wange? Tetulifa.\n  Ayi Mukama ggwe wabateekawo n’obawa amaanyi batusalire emisango.\n    Era ggwe Olwazi, wabateekawo kubonereza.",
        "reference": "Kaabakuuku 1:12",
        "verseNumber": "12",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd465cf",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.13",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Amaaso go gajjudde obulongoofu tegatunula ku kibi,\n    so toyinza kugumiikiriza bukyamu.\n  Kale lwaki ggwe ogumiikiriza ab’enkwe,\n    n’osirika ng’omubi amalirawo ddala\n    omuntu amusinga obutuukirivu?",
        "reference": "Kaabakuuku 1:13",
        "verseNumber": "13",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd46635",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.14",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Kubanga abantu obafudde ng’ebyennyanja eby’omu nnyanja,\n    ng’ebitonde eby’omu nnyanja ebitaliiko abifuga.",
        "reference": "Kaabakuuku 1:14",
        "verseNumber": "14",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd46674",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.15",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Omulabe omubi abakwata bonna ng’eddobo,\n    oluusi n’abawalula mu katimba ke,\n  n’abakuŋŋaanya mu kiragala kye\n    n’alyoka asanyuka n’ajaguza.",
        "reference": "Kaabakuuku 1:15",
        "verseNumber": "15",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd466a7",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.16",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Kyava awaayo ssaddaaka eri akatimba ke\n    n’ayotereza n’ekiragala kye obubaane;\n  akatimba ke kamuwa obulamu obw’okwejalabya,\n    n’alya emmere ey’ekigagga.",
        "reference": "Kaabakuuku 1:16",
        "verseNumber": "16",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5a7e4909dcafd466c6",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.1.17",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cd65",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.1",
            "number": "1",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.1",
        "content": "Kale, bwe batyo bwe banaalekebwa okutikkula obutimba bwabwe,\n    n’okusaanyaawo amawanga awatali kusaasira?",
        "reference": "Kaabakuuku 1:17",
        "verseNumber": "17",
        "chapterNumber": 1,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.1.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd467e1",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.1",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Kale ndiyimirira mu kifo kyange we ntera okubeera\n    ntunule nga ndi waggulu eyo ku ggulumu\n  nnindirire ky’aliŋŋamba,\n    era ne kye ndimuddamu ekikwata ku kwemulugunya kw’abantu.",
        "reference": "Kaabakuuku 2:1",
        "verseNumber": "1",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46805",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.2",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Awo Mukama n’anziramu n’ayogera nti,\n  “Wandiika okwolesebwa okwo ku bipande.\n    Kuwandiike bulungi\n    ate omubaka gwe banaatuma, akutwale bunnambiro.",
        "reference": "Kaabakuuku 2:2",
        "verseNumber": "2",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46874",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.3",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Kubanga okwolesebwa okwo kujja mu kiseera kyakwo ekigere.\n    Kwogera ku by’enkomerero\n    ate si kwa bulimba.\n  Bwe kunaaba ng’okuluddewo, mukulindirire,\n    kujja kutuukirira, tekugya kulwa.",
        "reference": "Kaabakuuku 2:3",
        "verseNumber": "3",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd468ed",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.4",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "“Laba oyo ow’emmeeme eteri nnongoofu wa kugwa,\n    naye omutuukirivu aliba mulamu olw’obwesigwa bwe.”",
        "reference": "Kaabakuuku 2:4",
        "verseNumber": "4",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46986",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.5",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Weewaawo, omwenge mulimba\n    guleetera omuntu amalala, ate taguwummulako.\n  Ate olwokubanga gwa mululu ng’emagombe, mu butakkuta gufaanana okufa.\n    Era okufaanana ng’olumbe, tegukkuta,\n  amawanga gonna gugeekuŋŋanyizaako\n    ne gugafuula abasibe.",
        "reference": "Kaabakuuku 2:5",
        "verseNumber": "5",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46a11",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.6",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "“Bano bonna si be balimugererako engero bamusekerere nga bagamba nti,\n  “ ‘Zimusanze oyo eyeyongeza ebitali bibye!\n    Oyo eyeetuumako obugagga obuva mu nguzi!’",
        "reference": "Kaabakuuku 2:6",
        "verseNumber": "6",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46a95",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.7",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Abakubanja tebalikuyimukirako nga tomanyiridde,\n    era tebalizuukuka ne bakweraliikiriza?\n    Oliba togudde mu mikono gyabwe?",
        "reference": "Kaabakuuku 2:7",
        "verseNumber": "7",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46ae0",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.8",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Kubanga onyaze amawanga mangi,\n    abantu abasigaddewo balikunyaga;\n  Oyiye omusaayi gw’abantu,\n    n’oyonoona ensi n’ebibuga n’abantu bonna ababibeeramu.”",
        "reference": "Kaabakuuku 2:8",
        "verseNumber": "8",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46b09",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.9",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Zimusanze oyo azimbira amaka ge ku bikolwa ebibi,\n    azimba ekisu kye waggulu,\n    okwekuuma obutatuukwako kabi!",
        "reference": "Kaabakuuku 2:9",
        "verseNumber": "9",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46b31",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.10",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Wategeka okuzikirira kw’abantu bangi,\n    n’oswaza ennyumba yo ne weefiiriza obulamu bwo.",
        "reference": "Kaabakuuku 2:10",
        "verseNumber": "10",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5b7e4909dcafd46b62",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.11",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Amayinja g’oku bbugwe galikaaba,\n    n’emikiikiro gy’ebibajje girikyasanguza.",
        "reference": "Kaabakuuku 2:11",
        "verseNumber": "11",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46bab",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.12",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Zimusanze oyo azimba ekibuga n’omusaayi,\n    atandika ekibuga n’obutali butuukirivu.",
        "reference": "Kaabakuuku 2:12",
        "verseNumber": "12",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46be7",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.13",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Tekyategekebwa Mukama ow’Eggye\n    nti okutegana kw’abantu nku buku za muliro,\n    n’amawanga geemalamu ensa olw’ebintu ebitaliimu?",
        "reference": "Kaabakuuku 2:13",
        "verseNumber": "13",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46c0c",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.14",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Kubanga ensi erijjula okumanya ekitiibwa kya Mukama,\n    ng’amazzi bwe ganjaala ku nnyanja.",
        "reference": "Kaabakuuku 2:14",
        "verseNumber": "14",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46c3b",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.15",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Zimusanze oyo awa baliraanwa be ekitamiiza\n    n’akibafukira okuva mu kita n’abawa banywe okutuusa lwe batamiira\n    asobole okutunuulira ensonyi zaabwe!",
        "reference": "Kaabakuuku 2:15",
        "verseNumber": "15",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46c64",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.16",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Olijjuzibwa ensonyi mu kifo ky’ekitiibwa.\n    Naawe olinywa n’oswala.\n  Ekikompe eky’omu mukono gwa Mukama ogwa ddyo kirikyusibwa kidde gy’oli,\n    n’ensonyi ez’obuwemu zisaanikire ekitiibwa kyo.",
        "reference": "Kaabakuuku 2:16",
        "verseNumber": "16",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46c9f",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.17",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Ebikolwa eby’obukambwe bye watuusa ku Lebanooni,\n    n’okutta ensolo, birikutiisa.\n  Osse abantu\n    n’ozikkiriza ensi n’ebibuga n’abantu ababibeeramu.",
        "reference": "Kaabakuuku 2:17",
        "verseNumber": "17",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46cdf",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.18",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "“Ekifaananyi ekyole kigasa ki? Anti kibajje bubazzi.\n    Oba ekifaananyi eky’ekyuma, ekisomesa obulimba?\n  Kubanga omuweesi yeesiga mirimu gya mikono gye\n    nga akola ebifaananyi ebitayogera!",
        "reference": "Kaabakuuku 2:18",
        "verseNumber": "18",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46d48",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.19",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Zimusanze oyo agamba omuti nti, ‘Lamuka;’\n    agamba ejjinja nti, ‘Golokoka!’\n  Kino kisobola okuluŋŋamya?\n    Kibikiddwa zaabu ne ffeeza,\n    so tekiriimu bulamu n’akatono.",
        "reference": "Kaabakuuku 2:19",
        "verseNumber": "19",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5c7e4909dcafd46d90",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.2.20",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdbe",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.2",
            "number": "2",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.2",
        "content": "Naye Mukama ali mu yeekaalu ye entukuvu:\n    ensi zonna zisiriikirire mu maaso ge.”",
        "reference": "Kaabakuuku 2:20",
        "verseNumber": "20",
        "chapterNumber": 2,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.2.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd46f07",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.1",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Ayi Mukama, mpulidde ebigambo byo;\n    mpulidde ettutumu lyo Ayi Mukama, ne ntya.\n  Bizze buggya mu nnaku zaffe,\n    bimanyise mu biro bino,\n    era mu busungu jjukira okusaasira.",
        "reference": "Kaabakuuku 3:1",
        "verseNumber": "1",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd46f5b",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.2",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Katonda yajja ng’ava e Temani,\n    Omutukuvu oyo ng’ava ku lusozi Palani.\n  Ekitiibwa kye kyatimbibwa ku ggulu,\n    ensi n’eryoka ejjula ettendo lye.",
        "reference": "Kaabakuuku 3:2",
        "verseNumber": "2",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd46f8d",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.3",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Okumasamasa kwe ne kulyoka kubeera ng’enjuba evaayo.\n    Ebimyanso byayakanga okuva mu mukono gwe,\n    era omwo mwe mwasinziiranga amaanyi ge ag’ekitalo.",
        "reference": "Kaabakuuku 3:3",
        "verseNumber": "3",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd46fb9",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.4",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Kawumpuli ye yakulembera,\n    Endwadde endala zinaamutta ne zigoberera.",
        "reference": "Kaabakuuku 3:4",
        "verseNumber": "4",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd46fe8",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.5",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Yayimirira n’anyeenyanyeenya ensi;\n    Yatunula n’akankanya amawanga.\n  Ensozi ez’edda za merenguka,\n    obusozi obw’edda ne buggwaawo. Engeri ze, za mirembe na mirembe.",
        "reference": "Kaabakuuku 3:5",
        "verseNumber": "5",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd4701e",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.6",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Nalaba eweema z’e Kusani nga ziri mu nnaku:\n    n’entimbe ez’ensi ya Midiyaani nga zijugumira.",
        "reference": "Kaabakuuku 3:6",
        "verseNumber": "6",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd47043",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.7",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Ayi Mukama, wanyiigira emigga?\n    Obusungu bwo bwali ku bugga obutono?\n  Wanyiigira ennyanja\n    bwe weebagala embalaasi zo,\n    n’olinnya ku magaali go ag’obuwanguzi?",
        "reference": "Kaabakuuku 3:7",
        "verseNumber": "7",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd4708a",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.8",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Wasowolayo akasaale ko,\n    wategeka okulasa obusaale;\n  ensi n’ogyawulayawulamu n’emigga.",
        "reference": "Kaabakuuku 3:8",
        "verseNumber": "8",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd470f5",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.9",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Ensozi zaakulaba, ne zeenyogootola;\n  Amataba ne gayitawo mbiro,\n    obuziba bw’ennyanja ne buwuluguma,\n    ne busitula amayengo gaayo waggulu.",
        "reference": "Kaabakuuku 3:9",
        "verseNumber": "9",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd4715f",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.10",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Enjuba n’omwezi ne biyimirira butengerera mu bifo byabyo,\n    olw’okumyansa kw’obusaale bwo nga buwenyuka,\n    n’olw’okumyansa kw’effumu lyo eritemagana.",
        "reference": "Kaabakuuku 3:10",
        "verseNumber": "10",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd471db",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.11",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Watambula okuyita mu nsi ng’ojjudde ekiruyi,\n    wasambirirasambirira amawanga mu busungu bwo.",
        "reference": "Kaabakuuku 3:11",
        "verseNumber": "11",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd47245",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.12",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Wavaayo oleetere abantu bo obulokozi,\n    olokole gwe wafukako amafuta;\n  Wabetenta omukulembeze w’ensi ekola ebibi,\n    ng’omwerulira ddala okuva ku mutwe okutuuka ku bigere.",
        "reference": "Kaabakuuku 3:12",
        "verseNumber": "12",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd47277",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.13",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Wafumita omutwe gwe n’effumu lye ye,\n    abalwanyi be bwe baavaayo okutugoba,\n  nga bali ng’abanaatumalawo,\n    ffe abaali baweddemu essuubi nga twekwese.",
        "reference": "Kaabakuuku 3:13",
        "verseNumber": "13",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd472b8",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.14",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Walinnyirira ennyanja n’embalaasi zo,\n    n’otabangula amazzi amangi.",
        "reference": "Kaabakuuku 3:14",
        "verseNumber": "14",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5d7e4909dcafd472e6",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.15",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Nawulira, n’omutima gwange ne gukankana\n    n’emimwa gyange gijugumira olw’eddoboozi eryo;\n  Obuvundu ne buyingira mu magumba gange,\n    amagulu gange ne gakankana.\n  Naye nnaalindirira n’obugumiikiriza olunaku olw’okulabiramu ennaku\n    bwe lulijjira eggwanga eritulumba.",
        "reference": "Kaabakuuku 3:15",
        "verseNumber": "15",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5e7e4909dcafd47301",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.16",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Wadde omutiini tegutojjera,\n    so n’emizabbibu nga tegiriiko bibala,\n  amakungula g’emizeeyituuni ne gabula,\n    ennimiro ne zitabala mmere n’akamu,\n  endiga nga ziweddemu mu kisibo,\n    nga n’ente tezikyalimu mu biraalo,",
        "reference": "Kaabakuuku 3:16",
        "verseNumber": "16",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5e7e4909dcafd47361",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.17",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "kyokka ndijaguliza Mukama,\n    ne nsanyukira mu Katonda Omulokozi wange.",
        "reference": "Kaabakuuku 3:17",
        "verseNumber": "17",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
    {
        "_id": "64121a5e7e4909dcafd473b2",
        "bibleId": "f276be3571f516cb-01",
        "id": "HAB.3.18",
        "__v": 0,
        "bookId": "HAB",
        "chapter": {
            "_id": "62661e21c35ce9345aa3cdfc",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "HAB",
            "id": "HAB.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ccd5"
        },
        "chapterId": "HAB.3",
        "content": "Mukama Katonda, ge maanyi gange;\n    afuula ebigere byange okuba ng’eby’empeewo,\n    era ansobozesa okutambulira mu bifo ebigulumivu.",
        "reference": "Kaabakuuku 3:18",
        "verseNumber": "18",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/HAB/HAB.3.mp3"
    },
