            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bd17999137613db5083"
        },
        "chapterId": "2TH.2",
        "content": "na ɔnam bɔne so adaadaa wɔn a wɔbɛyera no. Wɔbɛyera, ɛfiri sɛ, wɔannye nokorɛ no anto mu, annɔ nokorɛ no amma wɔannya nkwa.",
        "reference": "2 Tesalonikafoɔ 2:10",
        "verseNumber": "10",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
