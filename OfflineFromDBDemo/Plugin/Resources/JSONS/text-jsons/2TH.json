        },
        "chapterId": "2TH.1",
        "content": "Nwoma yi firi Paulo, Silas ne Timoteo nkyɛn,\n    \n    Yɛde kɔma Tesalonika asafo a wɔyɛ Agya Onyankopɔn ne Awurade Yesu Kristo nkurɔfoɔ no:",
        "reference": "2 Tesalonikafoɔ 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b590a5531092a820c41364",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "2TH.1.2",
        "__v": 0,
        "bookId": "2TH",
        "chapter": {
            "_id": "626b6bd17999137613db50b3",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "2TH",
