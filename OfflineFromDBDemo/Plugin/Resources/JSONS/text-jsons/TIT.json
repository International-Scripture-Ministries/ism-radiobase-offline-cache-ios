        },
        "chapterId": "TIT.1",
        "content": "Nwoma yi firi Onyankopɔn ɔsomfoɔ ne Yesu Kristo somafoɔ Paulo nkyɛn. Wɔyii me na wɔsomaa me sɛ memmɛboa nhyɛ nnipa a Onyankopɔn ayi wɔn no gyidie mu den na menkyerɛkyerɛ wɔn nokwasɛm a ɛde nyamesuro ba,",
        "reference": "Tito 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b590bf531092a820c469cd",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "TIT.1.2",
        "__v": 0,
        "bookId": "TIT",
        "chapter": {
