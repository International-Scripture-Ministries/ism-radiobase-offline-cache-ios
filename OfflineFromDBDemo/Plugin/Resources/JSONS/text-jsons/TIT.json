            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bd27999137613db53cb"
        },
        "chapterId": "TIT.1",
        "content": "a ne nnyinasoɔ yɛ nkwa a ɛnni awieeɛ no. Onyankopɔn a ɔnni atorɔ no hyɛɛ yɛn asetena yi ho bɔ ansa na ɔrefiri ewiase ase;",
        "reference": "Tito 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b590bf531092a820c469f5",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "TIT.1.3",
        "__v": 0,
