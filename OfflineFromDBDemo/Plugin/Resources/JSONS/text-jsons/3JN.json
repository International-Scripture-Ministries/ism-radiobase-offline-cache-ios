            "book": "626b6bd57999137613db5cca"
        },
        "chapterId": "3JN.1",
        "content": "Me, Asɔre panin,\n    \n    Meretwerɛ akɔma me dɔfo pa Gaio.",
        "reference": "3 Yohane 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b5910b531092a820c57341",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "3JN.1.2",
        "__v": 0,
        "bookId": "3JN",
        "chapter": {
            "_id": "626b6bd57999137613db5d2b",
