            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "3JN",
            "id": "3JN.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bd57999137613db5cca"
        },
        "chapterId": "3JN.1",
        "content": "Asomdwoeɛ nka mo.\n    \n    Mo nnamfonom nyinaa kyeakyea mo. Kyeakyea yɛn nnamfonom nyinaa.",
        "reference": "3 Yohane 1:15",
        "verseNumber": "15",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    }
]