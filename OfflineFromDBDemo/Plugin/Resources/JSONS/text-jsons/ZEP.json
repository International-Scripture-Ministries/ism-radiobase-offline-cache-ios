            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Mukama Katonda ali naawe,\n    ow’amaanyi alokola:\n  alikusanyukira,\n    alikukkakkanyiza mu kwagala kwe,\n    alikusanyukira n’okuyimba.”",
        "reference": "Zeffaniya 3:17",
        "verseNumber": "17",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
