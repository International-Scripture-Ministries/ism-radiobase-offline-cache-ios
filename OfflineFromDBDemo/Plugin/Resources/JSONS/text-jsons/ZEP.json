        "chapterId": "ZEP.3",
        "content": "“Ennaku eyabakwatanga olw’embaga ezabakuŋŋaanyanga\n    ndigibaggyako;\n    kubanga kibafuukidde omugugu.",
        "reference": "Zeffaniya 3:18",
        "verseNumber": "18",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
