        },
        "chapterId": "ZEP.3",
        "content": "“Mu biro ebyo ndirongoosa enjogera ey’amawanga;\n    bonna balikoowoola erinnya lya Mukama,\n    okumuweereza n’omwoyo gumu.",
        "reference": "Zeffaniya 3:9",
        "verseNumber": "9",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
