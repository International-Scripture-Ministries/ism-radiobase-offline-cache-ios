            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Laba, mu biro ebyo ndibonereza\n    abo bonna abaakubonyaabonya:\n  era ndinunula omulema,\n    ne nkuŋŋaanya n’abo abaasaasaanyizibwa;\n  era ndibafuula ettendo ne mbawa ekitiibwa\n    mu nsi zonna gye baaswazibwa.",
        "reference": "Zeffaniya 3:19",
        "verseNumber": "19",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
