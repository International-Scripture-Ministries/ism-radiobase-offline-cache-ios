            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Okuva emitala w’emigga egy’Obuwesiyopya,\n    abo abansinza, abantu bange abasaasaana,\n    balindeetera ssaddaaka.",
        "reference": "Zeffaniya 3:10",
        "verseNumber": "10",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
