[
    {
        "_id": "64b58e37531092a820bb9b20",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.1",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Awurade asɛm a ɛbaa Sefania a ɔyɛ Kusi ba, Gedalia ba, Amaria ba, Hesekia ba nkyɛn nie. Ɛbaa Yudahene Yosia a ɔyɛ Amon ba berɛ so.",
        "reference": "Sefania 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e37531092a820bb9b3f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.2",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Mɛpra biribiara afiri asase so”\n    deɛ Awurade seɛ nie,",
        "reference": "Sefania 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e37531092a820bb9b75",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.3",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Mɛpra nnipa ne mmoa nyinaa;\n    mɛpra nnomaa a wɔwɔ ewiem\n  ne mpataa a wɔwɔ ɛpo mu nyinaa.\n    Atirimuɔdenfoɔ bɛnya wira a ɛsum hɔ nko ara\n  sɛ mesɛe adasamma a wɔwɔ asase yi so a,”\n    deɛ Awurade seɛ nie.",
        "reference": "Sefania 1:3",
        "verseNumber": "3",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e37531092a820bb9b9c",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.4",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Mɛtene me nsa wɔ Yuda\n    ne wɔn a wɔte Yerusalem nyinaa so;\n  na mɛsɛe Baal ho biribiara a aka wɔ ha,\n    na masɛe abosonsomfoɔ ne abosomfoɔ asɔfoɔ no din",
        "reference": "Sefania 1:4",
        "verseNumber": "4",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9bdc",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.5",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "wɔn a wɔkoto sɔre wɔn adan atifi,\n    de sɔre abɔdeɛ a ɛwɔ ewiem,\n  wɔn a wɔkoto de Awurade ka ntam\n    na wɔde Molek nso ka ntam,",
        "reference": "Sefania 1:5",
        "verseNumber": "5",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9c2e",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.6",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "wɔn nso a wɔgyae Awurade akyiridie\n    na wɔnhwehwɛ Awurade anaa wɔmmisa nʼase.”",
        "reference": "Sefania 1:6",
        "verseNumber": "6",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9c91",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.7",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Monyɛ komm wɔ Asafo Awurade anim,\n    ɛfiri sɛ, Awurade ɛda no abɛn.\n  Awurade asiesie afɔrebɔdeɛ;\n    wadwira wɔn a wato nsa afrɛ wɔn no ho.",
        "reference": "Sefania 1:7",
        "verseNumber": "7",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9ccd",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.8",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Awurade afɔrebɔ ɛda no,\n    mɛtwe mmapɔmma\n    ne ahenemma\n  ne wɔn a wɔhyehyɛ\n    ananafoɔ ntadeɛ nyinaa aso.",
        "reference": "Sefania 1:8",
        "verseNumber": "8",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9d2f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.9",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Saa ɛda no mɛtwe wɔn\n    a wɔkwati aponnwa no nyinaa aso.\n  Wɔn a wɔde akakabensɛm\n    ne nsisie hyehyɛ wɔn abosomfie ma no.",
        "reference": "Sefania 1:9",
        "verseNumber": "9",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9d44",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.10",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Saa ɛda no,”\n    sɛdeɛ Awurade seɛ nie,\n  “Esu bɛfiri Mpataa Ɛpono ano,\n    agyaadwotwa bɛfiri Atenaeɛ Foforɔ\n    na nnyegyeeɛ a ano yɛ den afiri nkokoɔ no so aba.",
        "reference": "Sefania 1:10",
        "verseNumber": "10",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9d8d",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.11",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Montwa adwo, mo a mote adetɔnbea hɔ no\n    wɔbɛtɔre wɔn a mo ne wɔn di dwa ase,\n    dwetɛ adwadifoɔ nyinaa nso wɔbɛsɛe wɔn.",
        "reference": "Sefania 1:11",
        "verseNumber": "11",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9e01",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.12",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Mede nkanea bɛkyini ahwehwɛ Yerusalem mu\n    na matwe wɔn a wɔgyaagyaa wɔn ho aso,\n    wɔn a wɔte sɛ bobesa puo no,\n  a wɔdwene sɛ, ‘Awurade nnyɛ wɔn hwee\n    sɛ ɛyɛ papa anaa bɔne.’",
        "reference": "Sefania 1:12",
        "verseNumber": "12",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9e28",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.13",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Wɔbɛfom wɔn ahonyadeɛ,\n    na wɔabubu wɔn afie agu.\n  Wɔbɛsisi afie, nanso wɔrentena mu\n    wɔbɛyɛ bobe mfuo\n    nanso wɔrennom emu nsã.”",
        "reference": "Sefania 1:13",
        "verseNumber": "13",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9e6c",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.14",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Awurade ɛda kɛseɛ no abɛn,\n    abɛn na ɛreba ntɛm so.\n  Tie! Osu a wɔbɛsu Awurade ɛda no bɛyɛ ya,\n    ɔkofoɔ a ɔwɔ hɔ nso nteamu bɛyɛ saa ara.",
        "reference": "Sefania 1:14",
        "verseNumber": "14",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9ea0",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.15",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Saa ɛda no bɛyɛ abufuo ɛda,\n    ɛyɛ ahoyera ne ɔyea ɛda;\n    ɛyɛ amanehunu ne ɔsɛeɛ ɛda,\n    ɛyɛ esum ne kusukuukuu ɛda\n    ɛyɛ omununkum ne kusuuyɛ ɛda,",
        "reference": "Sefania 1:15",
        "verseNumber": "15",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9f01",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.16",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "ɛyɛ totorobɛnto hyɛn ne ɔko nteam\n  a ɛtia nkuropɔn a ɛwɔ banbɔ\n    ne ntwɛtwɛaso abantenten ɛda.",
        "reference": "Sefania 1:16",
        "verseNumber": "16",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9f1f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.17",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "“Mede awerɛhoɔ bɛba nnipa no so\n    na wɔbɛnante sɛ anifirafoɔ,\n    ɛfiri sɛ wɔayɛ bɔne atia Awurade.\n  Wɔbɛhwie wɔn mogya agu sɛ mfuturo,\n    na wɔn ayamdeɛ nso sɛ atantanneɛ.",
        "reference": "Sefania 1:17",
        "verseNumber": "17",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e38531092a820bb9f45",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.1.18",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2851",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.1",
        "content": "Wɔn dwetɛ anaa sikakɔkɔɔ\n    rentumi nnye wɔn nkwa\n  wɔ Awurade abufuo ɛda no.”\n    \n    Ne ninkuntwe mu ogya no\n  bɛhye ɔman no nyinaa,\n    na ɔbɛma asase no so tefoɔ nyinaa nkwa\n    aba awieeɛ mpofirim.",
        "reference": "Sefania 1:18",
        "verseNumber": "18",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba08d",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.1",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Mommoaboa mo ho ano, mommoaboa mo ho ano,\n    Ao, animguaseɛ ɔman,",
        "reference": "Sefania 2:1",
        "verseNumber": "1",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba0c6",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.2",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "ansa na ɛberɛ a wɔahyɛ no aduru,\n    na ɛda no resene te sɛ ntɛtɛ,\n  ansa na Awurade abufuhyeɛ no\n    aba mo so,\n  ansa na Awurade abufuo ɛda no\n    aba mo so.",
        "reference": "Sefania 2:2",
        "verseNumber": "2",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba0f7",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.3",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Monhwehwɛ Awurade, ahobrɛasefoɔ a mowɔ asase so,\n    mo a moyɛ nʼahyɛdeɛ.\n  Monhwehwɛ tenenee, monhwehwɛ ahobrɛaseɛ;\n    ebia ɔbɛkora mo\n    Awurade abufuo ɛda no.",
        "reference": "Sefania 2:3",
        "verseNumber": "3",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba142",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.4",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Wɔbɛgya Gasa\n    na wɔagya Askelon sɛ kurofo.\n  Owigyinaeɛ na ɔbɛma Asdod ada mpam\n    na wɔatutu Ekron ase.",
        "reference": "Sefania 2:4",
        "verseNumber": "4",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba17f",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.5",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Monnue mo a mote mpoano,\n    Ao, mo Keretifoɔ;\n  Awurade asɛm tia mo.\n    Ao, Kanaan, Filistifoɔ asase.\n  Mɛtɔre mo ase,\n    na obiara renka.",
        "reference": "Sefania 2:5",
        "verseNumber": "5",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba1d5",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.6",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Asase a ɛda mpoano, baabi a Keretifoɔ teɛ\n    bɛyɛ atenaeɛ ama nnwanhwɛfoɔ\n    ne wɔn nnwammuo.",
        "reference": "Sefania 2:6",
        "verseNumber": "6",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba238",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.7",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Saa asase no bɛyɛ Yudafie nkaeɛfoɔ no dea;\n    ɛhɔ na wɔbɛnya mmoa adidibea.\n  Anwummerɛ wɔbɛdeda wɔ\n    Askelon afie mu.\n  Na Awurade, wɔn Onyankopɔn bɛhwɛ wɔn,\n    na ɔde wɔn ahonyadeɛ nyinaa bɛsane ama wɔn.",
        "reference": "Sefania 2:7",
        "verseNumber": "7",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba294",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.8",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "“Mate Moab nsopa ne\n    Amonfoɔ atweetweɛ;\n  wɔn a wɔsopaa me nkurɔfoɔ\n    na wɔhunahunaa wɔn wɔ wɔn asase ho.",
        "reference": "Sefania 2:8",
        "verseNumber": "8",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba2b3",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.9",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Enti, sɛ mete ase yi,”\n    sɛdeɛ Asafo Awurade,\n    Israel Onyankopɔn, seɛ nie,\n  “Ampa ara Moab bɛyɛ sɛ Sodom,\n    na Amonfoɔ ayɛ sɛ Gomora,\n  baabi a ewira ne nkyɛn amena wɔ,\n    asase a ɛda mpan afebɔɔ.\n  Me ɔman nkaeɛ bɛfom wɔn afa;\n    me manfoɔ a wɔbɛnya wɔn ti adidim bɛfa wɔn asase.”",
        "reference": "Sefania 2:9",
        "verseNumber": "9",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba2d2",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.10",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Wɔn ahantan so akatua a wɔbɛnya nie,\n    sɛ wɔsopa na wɔtwetwe Asafo Awurade nkurɔfoɔ enti.",
        "reference": "Sefania 2:10",
        "verseNumber": "10",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e39531092a820bba311",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.11",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Awurade ho suro bɛba wɔn so\n    ɛberɛ a ɔbɛsɛe asase no so anyame nyinaa.\n  Mpoano aman nyinaa bɛsɔre no,\n    wɔ wɔn ankasa wɔn asase so.",
        "reference": "Sefania 2:11",
        "verseNumber": "11",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba341",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.12",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "“Mo Etiopiafoɔ nso,\n    mʼakofena ano na wɔbɛkunkum mo.”",
        "reference": "Sefania 2:12",
        "verseNumber": "12",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba37e",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.13",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Awurade bɛtene ne nsa wɔ atifi aman so\n    na wasɛe Asiria,\n  na wama Ninewe ada mpan koraa\n    na ɛso awo wesee sɛ anwea pradada so.",
        "reference": "Sefania 2:13",
        "verseNumber": "13",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba3ea",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.14",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Nnwankuo ne anantwie bɛdeda hɔ,\n    mmoadoma nyinaa.\n  Ɛserɛ so patuo ne ɔbonsam anoma\n    bɛtena nʼadum no so.\n    Wɔn su bɛgyegye mpomma mu,\n  mmubuiɛ bɛsisi apono ano akwan,\n    mpunan a wɔde ntweneduro ayɛ no ho bɛdeda hɔ.",
        "reference": "Sefania 2:14",
        "verseNumber": "14",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba424",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.2.15",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc47999137613db2869",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.2",
            "number": "2",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.2",
        "content": "Yei ne kuropɔn a ɛdi ahurisie\n    na ɛte asomdwoeɛ mu.\n  Ɔhoahoa ne ho sɛ,\n    “Me ne no, obiara nte sɛ me.”\n  Hwɛ sɛ deɛ atete apansam,\n    na ayɛ nkeka mmoa atenaeɛ!\n  Obiara a ɔtwam hɔ no sere no,\n    hugya ne nsa fɛdie so.",
        "reference": "Sefania 2:15",
        "verseNumber": "15",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba586",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.1",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Nnome nka nhyɛsofoɔ kuropɔn\n    atuateɛ kuropɔn a ɛho agu fi!",
        "reference": "Sefania 3:1",
        "verseNumber": "1",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba5cb",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.2",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Ɔnnyɛ ɔsetie mma obiara\n    ɔnnye nteɛsoɔ biara nto mu.\n  Ɔmfa ne ho nto Awurade so.\n    Ɔntwi mmɛn ne Onyankopɔn.",
        "reference": "Sefania 3:2",
        "verseNumber": "2",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba5ff",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.3",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Nʼakandifoɔ yɛ agyata a wɔbobɔ mu,\n    ne sodifoɔ yɛ mpataku a wɔnam anadwo,\n  a wɔnnya biribiara mma adekyeɛ.",
        "reference": "Sefania 3:3",
        "verseNumber": "3",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba62e",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.4",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Ne nkɔmhyɛfoɔ yɛ ahantan;\n    wɔyɛ afatwafoɔ.\n  Nʼasɔfoɔ gu kronkronbea ho fi.\n    Wɔnam mmara no so di nsɛmmɔne.",
        "reference": "Sefania 3:4",
        "verseNumber": "4",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba656",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.5",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Awurade a ɔte ne mu no yɛ ɔteneneeni;\n    ɔnnyɛ mfomsoɔ biara.\n  Adekyeeɛ biara ɔda ne tenenee adi,\n    na ɔnni hwammɔ da,\n    nanso amumuyɛfoɔ deɛ wonnim aniwuo.",
        "reference": "Sefania 3:5",
        "verseNumber": "5",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3a531092a820bba6a5",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.6",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "“Masɛe amanaman;\n    madwiri wɔn abandenden agu.\n  Wɔn mmorɔno so adeda mpan,\n    a obiara ntwa mu hɔ.\n  Wɔaseɛ wɔn nkuropɔn;\n    a obi biara renka.",
        "reference": "Sefania 3:6",
        "verseNumber": "6",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba70a",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.7",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Meka kyerɛɛ kuropɔn no sɛ,\n    ‘ampa ara wobɛsuro me\n  na woagye nteɛsoɔ ato mu!’\n  Na afei ne tenaberɛ rensɛe,\n    na mʼasotwe biara nso remma ne so.\n  Nanso, wɔn ho peree wɔn\n    sɛ wɔbɛkɔso ayɛ bɔne wɔn nneyɛeɛ nyinaa mu.",
        "reference": "Sefania 3:7",
        "verseNumber": "7",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba784",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.8",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Enti, twɛn me,” sɛdeɛ Awurade seɛ nie,\n    “na ɛda no mɛsɔre adi adanseɛ.\n  Mayɛ mʼadwene sɛ mɛboaboa amanaman\n    ne ahennie ano\n  na mahwie mʼabufuo agu wɔn so\n    mʼabufuhyeɛ nyinaa.\n  Me ninkuntwe abufuo ogya mu no,\n    asase nyinaa bɛhye.",
        "reference": "Sefania 3:8",
        "verseNumber": "8",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba7d8",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.9",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "“Afei mɛdwira nnipa no ano,\n    na wɔn nyinaa abɔ Awurade din\n    na wɔaka abɔ mu asom no.",
        "reference": "Sefania 3:9",
        "verseNumber": "9",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba83b",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.10",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Mʼasomfoɔ, me nkurɔfoɔ a wɔabɔ ahwete no\n    bɛfiri nsubɔntene a ɛwɔ Kus nohoa\n    de wɔn afɔrebɔdeɛ abrɛ me.",
        "reference": "Sefania 3:10",
        "verseNumber": "10",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba860",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "ZEP.3.11",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "626b6bc57999137613db288a",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc47999137613db27aa"
        },
        "chapterId": "ZEP.3",
        "content": "Saa ɛda no, wo Yerusalem, wɔrengu wʼanim ase\n    wɔ nneyɛeɛ bɔne a woayɛ atia me ho,\n  ɛfiri sɛ mɛyi afiri saa kuropɔn yi mu,\n    wɔn a wodi ahantan mu ahurisie\n  na worenyɛ ahantan bio\n    wɔ me bepɔ kronkron no so.",
        "reference": "Sefania 3:11",
        "verseNumber": "11",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3b531092a820bba88a",
