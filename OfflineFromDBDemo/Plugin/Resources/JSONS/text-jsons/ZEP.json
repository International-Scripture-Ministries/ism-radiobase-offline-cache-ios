            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Ku lunaku olwo Yerusaalemi kirigambibwa nti,\n    “Totya, ggwe Sayuuni;\n    emikono gyo gireme okuddirira.",
        "reference": "Zeffaniya 3:16",
        "verseNumber": "16",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
    {
