            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Ekitundu kya Isirayiri ekirisigalawo tebalikola bitali bya butuukirivu\n    so tebalyogera bya bulimba\n    wadde okuba abakuusa.\n  Balirya, baligalamira,\n    so tewaliba alibatiisa.”",
        "reference": "Zeffaniya 3:13",
        "verseNumber": "13",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
    {
        "_id": "64121a637e4909dcafd48b2a",
        "bibleId": "f276be3571f516cb-01",
        "id": "ZEP.3.14",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
            "_id": "62661e22c35ce9345aa3cf1f",
            "bibleId": "f276be3571f516cb-01",
            "bookId": "ZEP",
            "id": "ZEP.3",
            "number": "3",
            "__v": 0,
            "bible": "62659940c35ce9345a7365de",
            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Yimba, ggwe omuwala wa Sayuuni;\n    yogerera waggulu, ggwe Isirayiri;\n  sanyuka ojaguze n’omutima gwo gwonna,\n    ggwe omuwala wa Yerusaalemi.",
        "reference": "Zeffaniya 3:14",
        "verseNumber": "14",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
    {
        "_id": "64121a637e4909dcafd48b68",
        "bibleId": "f276be3571f516cb-01",
        "id": "ZEP.3.15",
        "__v": 0,
        "bookId": "ZEP",
        "chapter": {
