            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Naye ndireka wakati mu ggwe\n    abantu abakakkamu era abeetoowaze,\n    abo abesiga erinnya lya Mukama.",
        "reference": "Zeffaniya 3:12",
        "verseNumber": "12",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
