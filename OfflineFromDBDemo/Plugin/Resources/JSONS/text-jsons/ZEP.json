            "book": "62661e21c35ce9345aa3ce26"
        },
        "chapterId": "ZEP.3",
        "content": "Mukama akuggyeeko ekibonerezo kyo,\n    agobyewo omulabe wo.\n  Kabaka wa Isirayiri, Mukama, ali naawe;\n    tokyaddayo kutya kabi konna.",
        "reference": "Zeffaniya 3:15",
        "verseNumber": "15",
        "chapterNumber": 3,
        "chapterAudioUrl": "https://cdn-cmp-audio.thruthebible.io/14b06ff3b2cf5e97-01/ZEP/ZEP.3.mp3"
    },
