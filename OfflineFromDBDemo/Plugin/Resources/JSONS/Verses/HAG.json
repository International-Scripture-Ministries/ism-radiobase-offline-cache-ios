            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "Asɛm a, Asafo Awurade ka nie: “Monnwene mo akwan ho yie.",
        "reference": "Hagai 1:5",
        "verseNumber": "5",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3d531092a820bbb0af",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.1.6",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "626b6bc57999137613db2947",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "HAG",
            "id": "HAG.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "Moduaa bebree, nanso motwaa kakraa bi. Modidi, nanso mommee. Monom, nanso osukɔm de mo ara. Mohyɛ ntadeɛ, nanso ɛnka mo hye. Monya akatua, na mode gu sikabɔtɔ a wɔatuetue mu ntokuro mu.”",
        "reference": "Hagai 1:6",
        "verseNumber": "6",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3d531092a820bbb0d5",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.1.7",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "626b6bc57999137613db2947",
