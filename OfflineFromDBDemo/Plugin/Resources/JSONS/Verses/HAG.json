            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "Afei, Awurade de saa asɛm yi faa Odiyifoɔ Hagai so:",
        "reference": "Hagai 1:3",
        "verseNumber": "3",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3d531092a820bbb00e",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.1.4",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "626b6bc57999137613db2947",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "HAG",
            "id": "HAG.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "“Saa ɛberɛ yi a me fie yi abubuo yi, ɛna mo deɛ motete mo afie a wɔaduradura mu yi anaa?”",
        "reference": "Hagai 1:4",
        "verseNumber": "4",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3d531092a820bbb072",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.1.5",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
