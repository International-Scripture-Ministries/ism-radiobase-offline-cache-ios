            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "wɔ Ɔhene Dario adedie afe a ɛtɔ so mmienu no, ɔbosome a ɛtɔ so nsia no da a ɛtɔ so aduonu ɛnan no.",
        "reference": "Hagai 1:15",
        "verseNumber": "15",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3f531092a820bbb3eb",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.2.1",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
            "_id": "626b6bc57999137613db2974",
