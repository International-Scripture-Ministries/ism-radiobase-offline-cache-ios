            "bible": "626b389679991376135363f7",
            "book": "626b6bc57999137613db28c5"
        },
        "chapterId": "HAG.1",
        "content": "Asɛm a Asafo Awurade ka nie: “Nnipa no reka sɛ, ‘Ɛberɛ no nnya nnuruiɛ sɛ wɔsi Awurade fie no.’ ”",
        "reference": "Hagai 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e3d531092a820bbafab",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "HAG.1.3",
        "__v": 0,
        "bookId": "HAG",
        "chapter": {
