        },
        "chapterId": "MAL.3",
        "content": "Na mobɛhunu nsonsonoeɛ a ɛda ateneneefoɔ ne amumuyɛfoɔ ntam, ne wɔn a wɔsom Onyankopɔn ne wɔn a wɔnnsom Onyankopɔn no ntam.",
        "reference": "Malaki 3:18",
        "verseNumber": "18",
        "chapterNumber": 3,
        "chapterAudioUrl": null
    },
