        },
        "chapterId": "MAL.1",
        "content": "Nkɔmhyɛ nsɛm a Awurade nam Odiyifoɔ Malaki so de maa Israel.",
        "reference": "Malaki 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b58e58531092a820bc08a4",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "MAL.1.2",
        "__v": 0,
        "bookId": "MAL",
        "chapter": {
            "_id": "626b6bc67999137613db2c9a",
            "bibleId": "c97c5e017bdf893c-01",
