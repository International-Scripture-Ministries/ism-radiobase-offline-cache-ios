            "bible": "626b389679991376135363f7",
            "book": "626b6bc67999137613db2c41"
        },
        "chapterId": "MAL.2",
        "content": "“Ɛsɛ sɛ ɔsɔfoɔ ano kora nimdeɛ. Nnipa hwehwɛ nkyerɛkyerɛ firi ne nkyɛn, ɛfiri sɛ ɔyɛ Asafo Awurade no somafoɔ.",
        "reference": "Malaki 2:7",
        "verseNumber": "7",
        "chapterNumber": 2,
        "chapterAudioUrl": null
    },
