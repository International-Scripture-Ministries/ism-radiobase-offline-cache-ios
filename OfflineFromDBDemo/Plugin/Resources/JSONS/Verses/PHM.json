        },
        "chapterId": "PHM.1",
        "content": "Nwoma yi firi Paulo a ɛsiane Kristo Yesu enti, meyɛ odeduani no ne yɛn nuabarima Timoteo nkyɛn,\n    \n    Yɛde kɔma yɛn adamfo ne yɛn yɔnko Filemon",
        "reference": "Filemon 1:1",
        "verseNumber": "1",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b590c4531092a820c47c68",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "PHM.1.2",
        "__v": 0,
        "bookId": "PHM",
        "chapter": {
            "_id": "626b6bd37999137613db5516",
            "bibleId": "c97c5e017bdf893c-01",
            "bookId": "PHM",
            "id": "PHM.1",
            "number": "1",
            "__v": 0,
            "bible": "626b389679991376135363f7",
            "book": "626b6bd27999137613db54ca"
        },
        "chapterId": "PHM.1",
        "content": "ne asafo a wɔhyia wɔ wo fie no ne yɛn nuabaa Apia ne yɛn yɔnko ɔsraani Arkipo no:",
        "reference": "Filemon 1:2",
        "verseNumber": "2",
        "chapterNumber": 1,
        "chapterAudioUrl": null
    },
    {
        "_id": "64b590c4531092a820c47cdf",
        "bibleId": "c97c5e017bdf893c-01",
        "id": "PHM.1.3",
        "__v": 0,
        "bookId": "PHM",
        "chapter": {
            "_id": "626b6bd37999137613db5516",
            "bibleId": "c97c5e017bdf893c-01",
